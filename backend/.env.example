# ───────────────────────────────────────────────────────────────
# OrderEasy API — variables de entorno
# Copia este archivo a .env (desarrollo) o .env.production (referencia para producción).
# En Render/Railway/Docker estas variables se cargan en el panel de la plataforma; no se sube el archivo.
# ───────────────────────────────────────────────────────────────

# development | production. En producción el esquema NO se altera solo (solo migraciones) y CORS_ORIGIN es obligatorio.
NODE_ENV=development

# Puerto. Render y otras plataformas definen PORT por su cuenta; en local queda 3000.
PORT=3000

# ── Base de datos PostgreSQL ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordereasy
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
# SSL: se activa solo si el host no es local. DB_SSL=true/false fuerza el valor.
# DB_SSL=false
# Máximo de conexiones del pool (los planes gratuitos limitan las conexiones simultáneas)
# DB_POOL_MAX=5
# Schema propio: úsalo cuando OrderEasy comparte la base con otra app (ver scripts/supabase-setup.sql).
# Déjalo vacío para usar el schema por defecto (public).
# DB_SCHEMA=ordereasy

# Aplicar scripts/migrations/*.sql al arrancar (recomendado). false = hacerlo a mano con: npm run migrate
RUN_MIGRATIONS=true

# ── Seguridad ─────────────────────────────────────────────────
# Mínimo 32 caracteres en producción. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_con_clave_aleatoria_larga

# Dominio(s) del frontend que pueden llamar a la API, separados por coma y SIN barra final.
# Ej.: https://ordereasy-web.onrender.com,https://app.tudominio.com
CORS_ORIGIN=http://localhost:5173

# true cuando la API va detrás de un proxy y NODE_ENV no es production
# TRUST_PROXY=true

# ── Imágenes de productos (Cloudinary) ────────────────────────
# Recomendado en producción: sin esto las imágenes se guardan en disco y se pierden al redesplegar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Asistente de IA (OpenRouter) — opcional ───────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
